{
  "name": "@yuri-schmaltz/mcp-godot",
  "version": "0.1.0",
  "description": "MCP server for interfacing with the Godot game engine. Provides tools for launching the editor, running projects, capturing debug output, and managing scenes. Maintained fork of Coding-Solo/godot-mcp.",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline",
    "cursor",
    "yuri-schmaltz"
  ],
  "homepage": "https://github.com/yuri-schmaltz/mcp-godot",
  "bugs": {
    "url": "https://github.com/yuri-schmaltz/mcp-godot/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuri-schmaltz/mcp-godot.git"
  },
  "license": "MIT",
  "author": "Yuri Schmaltz",
  "type": "module",
  "bin": {
    "mcp-godot": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node scripts/build.js",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
